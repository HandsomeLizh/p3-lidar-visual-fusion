Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 28; 32; 40
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 参考网格
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 80
      Color: 65; 74; 88
    - Class: rviz_default_plugins/PointCloud2
      Name: 三维点云（轻量显示）
      Enabled: true
      Topic:
        Value: /T3/demo/rviz_cloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Color: 130; 185; 210
      Axis: Z
      Autocompute Value Bounds:
        Value: true
      Style: Points
      Size (Pixels): 2
      Size (m): 0.12
      Alpha: 0.9
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: 车身候选回波（当前帧，仅显示）
      Enabled: true
      Topic:
        Value: /T3/demo/vehicle_returns
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 220; 225; 235
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Alpha: 1
      Decay Time: 0
      Queue Size: 2
    - Class: rviz_default_plugins/Path
      Name: 原始轨迹（真实高度）
      Enabled: false
      Topic:
        Value: /T3/semantic/trajectory
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 25; 255; 80
      Line Style: Lines
      Line Width: 0.06
      Buffer Length: 1
    - Class: rviz_default_plugins/Odometry
      Name: 车体定位坐标轴
      Enabled: true
      Covariance:
        Value: false
      Topic:
        Value: /T3/semantic/current_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 1
      Shape: Axes
      Position Tolerance: 0
      Angle Tolerance: 0
    - Class: rviz_default_plugins/TF
      Name: TF坐标系（可选）
      Enabled: false
      Show Names: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/MarkerArray
      Name: 橙色轨迹与青色车头（抬高显示）
      Enabled: true
      Topic:
        Value: /T3/demo/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: P4 局部路径（紫色）
      Enabled: true
      Topic:
        Value: /Car/T4/planning/local_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 238; 124; 255
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.16
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0.3
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 300
      Target Frame: map
      Pitch: 1.10
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Hide Left Dock: true
  Hide Right Dock: true
  X: 60
  Y: 38
  Width: 1050
  Height: 990
