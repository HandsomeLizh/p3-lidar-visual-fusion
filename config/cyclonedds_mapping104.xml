<!-- Hardware pipeline transport: avoid IP fragmentation for images and 64 m / 2 MB GridMaps.
     Sensor drivers keep their existing configuration. 104 already permits a
     10 MiB receive buffer; no system-wide kernel change is made here. -->
<CycloneDDS xmlns="https://cdds.io/config">
 <Domain id="any">
  <General>
   <Interfaces><NetworkInterface name="wlP1p1s0" multicast="true"/></Interfaces>
   <AllowMulticast>spdp</AllowMulticast>
   <MaxMessageSize>1400B</MaxMessageSize><FragmentSize>1280B</FragmentSize>
  </General>
  <Internal>
   <SocketReceiveBufferSize min="10485760B"/>
   <Watermarks><WhcHigh>10MB</WhcHigh></Watermarks>
  </Internal>
  <Discovery><ParticipantIndex>auto</ParticipantIndex><MaxAutoParticipantIndex>200</MaxAutoParticipantIndex>
   <Peers><Peer address="192.168.100.237"/><Peer address="localhost"/></Peers>
   <SPDPInterval>2s</SPDPInterval>
  </Discovery>
 </Domain>
</CycloneDDS>
