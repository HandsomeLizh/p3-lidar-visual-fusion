diff --git a/include/IKFoM/IKFoM_toolkit/esekfom/bounded_gain.hpp b/include/IKFoM/IKFoM_toolkit/esekfom/bounded_gain.hpp
new file mode 100644
index 0000000..ff53e71
--- /dev/null
+++ b/include/IKFoM/IKFoM_toolkit/esekfom/bounded_gain.hpp
@@ -0,0 +1,49 @@
+// Memory-bounded scalar-noise Kalman update for large simultaneous LiDAR batches.
+// The state-space solve is equivalent to K=P H' (H P H'+noise I)^-1.
+#pragma once
+#include <Eigen/Dense>
+#include <cmath>
+
+namespace esekfom {
+template <typename Scalar, int N>
+bool scalar_noise_gain(
+    const Eigen::Matrix<Scalar, N, N>& covariance,
+    const Eigen::Matrix<Scalar, Eigen::Dynamic, Eigen::Dynamic>& h,
+    Scalar noise,
+    Eigen::Matrix<Scalar, N, Eigen::Dynamic>& gain,
+    Eigen::Matrix<Scalar, N, N>& posterior) {
+  using State = Eigen::Matrix<Scalar, N, N>;
+  using Dynamic = Eigen::Matrix<Scalar, Eigen::Dynamic, Eigen::Dynamic>;
+  const Eigen::Index m = h.rows(), d = h.cols();
+  if (m < 1 || d < 1 || d > N || !std::isfinite(noise) || noise <= 0 ||
+      !covariance.allFinite() || !h.allFinite()) return false;
+  const State prior = (Scalar(.5) * (covariance + covariance.transpose())).eval();
+  if (m <= N) {
+    const Eigen::Matrix<Scalar, N, Eigen::Dynamic> pht =
+        prior.leftCols(d) * h.transpose();
+    Dynamic innovation = h * pht.topRows(d);
+    innovation.diagonal().array() += noise;
+    Eigen::LLT<Dynamic> solve(innovation);
+    if (solve.info() != Eigen::Success) return false;
+    gain = solve.solve(pht.transpose()).transpose();
+    // Joseph form preserves positive covariance under floating-point roundoff.
+    State remainder = State::Identity();
+    remainder.leftCols(d).noalias() -= gain * h;
+    posterior = remainder * prior * remainder.transpose()
+                + noise * gain * gain.transpose();
+  } else {
+    Eigen::LLT<State> prior_factor(prior);
+    if (prior_factor.info() != Eigen::Success) return false;
+    const State lower = prior_factor.matrixL();
+    const Dynamic hl = h * lower.topRows(d);
+    State information = State::Identity();
+    information.noalias() += hl.transpose() * hl / noise;
+    Eigen::LLT<State> solve(information);
+    if (solve.info() != Eigen::Success) return false;
+    gain.noalias() = lower * solve.solve((hl.transpose() / noise).eval());
+    posterior.noalias() = lower * solve.solve(lower.transpose());
+  }
+  posterior = (Scalar(.5) * (posterior + posterior.transpose())).eval();
+  return gain.allFinite() && posterior.allFinite();
+}
+}  // namespace esekfom
diff --git a/include/output_motion.hpp b/include/output_motion.hpp
new file mode 100644
index 0000000..b6f0321
--- /dev/null
+++ b/include/output_motion.hpp
@@ -0,0 +1,32 @@
+#pragma once
+#include <Eigen/Core>
+#include <Eigen/Geometry>
+
+namespace point_lio_motion {
+// Output-state ordering: p, R, R_ext, t_ext, v, omega, a, g, bg, ba.
+// With no IMU, acceleration/gravity are unobserved and must not drive motion.
+template<class State>
+Eigen::Matrix<double,30,1> derivative(const State& s, bool has_imu) {
+    Eigen::Matrix<double,30,1> f=Eigen::Matrix<double,30,1>::Zero();
+    f.template segment<3>(0)=s.vel;
+    f.template segment<3>(3)=s.omg;
+    if (has_imu)
+        f.template segment<3>(12)=s.rot.normalized()*s.acc+s.gravity;
+    return f;
+}
+template<class State>
+Eigen::Matrix<double,30,30> jacobian(const State& s, bool has_imu) {
+    Eigen::Matrix<double,30,30> F=Eigen::Matrix<double,30,30>::Zero();
+    F.template block<3,3>(0,12).setIdentity();
+    F.template block<3,3>(3,15).setIdentity();
+    if (has_imu) {
+        const auto R=s.rot.normalized().toRotationMatrix();
+        Eigen::Matrix3d skew;
+        skew << 0.,-s.acc[2],s.acc[1],s.acc[2],0.,-s.acc[0],-s.acc[1],s.acc[0],0.;
+        F.template block<3,3>(12,3)=-R*skew;
+        F.template block<3,3>(12,18)=R;
+        F.template block<3,3>(12,21).setIdentity();
+    }
+    return F;
+}
+}
