+#include <Eigen/Eigenvalues>
+#include <algorithm>
+#include <cmath>
+
+// Current-scan geometry evidence, independent of the motion prior or ground truth.
+// Point-to-plane normals must constrain translation in several directions; the
+// normalized six-dimensional information must also constrain rotation.
+struct RegistrationQuality {
+    using M6 = Eigen::Matrix<double, 6, 6>;
+    M6 information = M6::Zero();
+    double residual_square = 0.;
+    int matched = 0, candidates = 0;
+    void reset() { information.setZero(); residual_square = 0.; matched = candidates = 0; }
+    void add(const Eigen::MatrixXd &h, const Eigen::VectorXd &residual, int considered) {
+        candidates += considered;
+        if (h.rows() == 0) return;
+        information.noalias() += h.leftCols(6).transpose() * h.leftCols(6);
+        residual_square += residual.squaredNorm();
+        matched += h.rows();
+    }
+    double match_ratio() const { return double(matched) / std::max(1, candidates); }
+    double residual_rms() const { return matched ? std::sqrt(residual_square / matched) : 1e6; }
+    double translation_ratio() const {
+        if (!matched) return 0.;
+        Eigen::SelfAdjointEigenSolver<Eigen::Matrix3d> solver(information.topLeftCorner<3,3>());
+        if (solver.info() != Eigen::Success) return 0.;
+        return std::max(0., solver.eigenvalues()[0]) / std::max(1e-12, solver.eigenvalues()[2]);
+    }
+    double pose_ratio() const {
+        if (!matched) return 0.;
+        M6 normalized = information;
+        // Remove the arbitrary metre/radian lever-arm scale before testing rank.
+        double lever = std::sqrt(std::max(1e-12, information.bottomRightCorner<3,3>().trace()) /
+                                 std::max(1e-12, information.topLeftCorner<3,3>().trace()));
+        lever = std::max(.1, lever);
+        normalized.rightCols<3>() /= lever;
+        normalized.bottomRows<3>() /= lever;
+        Eigen::SelfAdjointEigenSolver<M6> solver(normalized);
+        if (solver.info() != Eigen::Success) return 0.;
+        return std::max(0., solver.eigenvalues()[0]) / std::max(1e-12, solver.eigenvalues()[5]);
+    }
+    bool reliable() const {
+        return matched >= 50 && match_ratio() >= .15 && residual_rms() <= .25 &&
+               translation_ratio() >= .02 && pose_ratio() >= .003;
+    }
+};
